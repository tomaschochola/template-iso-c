{
    "$schema": "https://gitlab.kitware.com/cmake/cmake/-/raw/v4.4.4/Help/manual/presets/schema.json",
    "version": 12,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 4,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_C_FLAGS": "$env{CFLAGS}",
                "CMAKE_COMPILE_WARNING_AS_ERROR": true,
                "CMAKE_LINK_WARNING_AS_ERROR": true,
                "CMAKE_EXE_LINKER_FLAGS": "$env{LDFLAGS}",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            },
            "warnings": {
                "author": true,
                "deprecated": true,
                "experimental": true,
                "installAbsoluteDestination": true,
                "policy": true,
                "uninitialized": true,
                "unusedCli": true
            },
            "errors": {
                "author": true,
                "deprecated": true,
                "experimental": true,
                "installAbsoluteDestination": true,
                "policy": true,
                "uninitialized": true,
                "unusedCli": true
            }
        },
        {
            "name": "debug-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "BUILD_TESTING": true,
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS_DEBUG": "-Og -g -fno-omit-frame-pointer"
            }
        },
        {
            "name": "release-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "BUILD_TESTING": false,
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXE_LINKER_FLAGS_RELEASE": "-s",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": true
            }
        },
        {
            "name": "debug",
            "inherits": "debug-base"
        },
        {
            "name": "release",
            "inherits": "release-base"
        },
        {
            "name": "fanalyzer",
            "inherits": "debug-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS_DEBUG": "-O0 -g -fno-omit-frame-pointer -fanalyzer -fanalyzer-transitivity -fanalyzer-call-summaries -Wanalyzer-too-complex -Wanalyzer-symbol-too-complex -Wno-error=analyzer-too-complex -Wno-error=analyzer-symbol-too-complex --param analyzer-bb-explosion-factor=20 --param analyzer-max-enodes-per-program-point=32 --param analyzer-max-constraints=80 --param analyzer-max-infeasible-edges=40 --param analyzer-max-recursion-depth=8 --param analyzer-max-svalue-depth=72"
            }
        },
        {
            "name": "asan",
            "inherits": "debug-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS_DEBUG": "-Og -g -fno-omit-frame-pointer -fno-optimize-sibling-calls -fno-ipa-icf -fsanitize=address,undefined,bounds-strict,pointer-compare,pointer-subtract,float-cast-overflow -fno-sanitize-recover=all"
            }
        },
        {
            "name": "ubsan",
            "inherits": "debug-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS_DEBUG": "-Og -g -fno-omit-frame-pointer -fno-optimize-sibling-calls -fno-ipa-icf -fsanitize=undefined,bounds-strict,float-cast-overflow -fno-sanitize-recover=all"
            }
        },
        {
            "name": "tsan",
            "inherits": "debug-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS_DEBUG": "-Og -g -fno-omit-frame-pointer -fno-optimize-sibling-calls -fno-ipa-icf -fsanitize=thread"
            }
        },
        {
            "name": "lsan",
            "inherits": "debug-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS_DEBUG": "-Og -g -fno-omit-frame-pointer -fno-optimize-sibling-calls -fno-ipa-icf -fsanitize=leak"
            }
        },
        {
            "name": "valgrind",
            "inherits": "debug-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS_DEBUG": "-O1 -g -fno-omit-frame-pointer"
            }
        },
        {
            "name": "coverage",
            "inherits": "debug-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS_DEBUG": "-O0 -g --coverage -fcondition-coverage -fprofile-abs-path"
            }
        },
        {
            "name": "linux-amd64-v1",
            "inherits": "release-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "$env{CFLAGS} -march=x86-64"
            }
        },
        {
            "name": "linux-amd64-v2",
            "inherits": "release-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "$env{CFLAGS} -march=x86-64-v2"
            }
        },
        {
            "name": "linux-amd64-v3",
            "inherits": "release-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "$env{CFLAGS} -march=x86-64-v3"
            }
        },
        {
            "name": "linux-arm64-armv8-a",
            "inherits": "release-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "$env{CFLAGS} -march=armv8-a"
            }
        },
        {
            "name": "linux-arm64-armv9-a",
            "inherits": "release-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "$env{CFLAGS} -march=armv9-a"
            }
        },
        {
            "name": "native",
            "inherits": "release-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "$env{CFLAGS} -march=native -mtune=native"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "fanalyzer",
            "configurePreset": "fanalyzer"
        },
        {
            "name": "asan",
            "configurePreset": "asan"
        },
        {
            "name": "ubsan",
            "configurePreset": "ubsan"
        },
        {
            "name": "tsan",
            "configurePreset": "tsan"
        },
        {
            "name": "lsan",
            "configurePreset": "lsan"
        },
        {
            "name": "valgrind",
            "configurePreset": "valgrind"
        },
        {
            "name": "coverage",
            "configurePreset": "coverage",
            "cleanFirst": true
        },
        {
            "name": "linux-amd64-v1",
            "configurePreset": "linux-amd64-v1"
        },
        {
            "name": "linux-amd64-v2",
            "configurePreset": "linux-amd64-v2"
        },
        {
            "name": "linux-amd64-v3",
            "configurePreset": "linux-amd64-v3"
        },
        {
            "name": "linux-arm64-armv8-a",
            "configurePreset": "linux-arm64-armv8-a"
        },
        {
            "name": "linux-arm64-armv9-a",
            "configurePreset": "linux-arm64-armv9-a"
        },
        {
            "name": "native",
            "configurePreset": "native"
        }
    ],
    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        },
        {
            "name": "debug",
            "inherits": "test-base",
            "configurePreset": "debug"
        },
        {
            "name": "fanalyzer",
            "inherits": "test-base",
            "configurePreset": "fanalyzer"
        },
        {
            "name": "asan",
            "inherits": "test-base",
            "configurePreset": "asan",
            "environment": {
                "ASAN_OPTIONS": "detect_invalid_pointer_pairs=2"
            }
        },
        {
            "name": "ubsan",
            "inherits": "test-base",
            "configurePreset": "ubsan",
            "environment": {
                "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
            }
        },
        {
            "name": "tsan",
            "inherits": "test-base",
            "configurePreset": "tsan",
            "environment": {
                "TSAN_OPTIONS": "halt_on_error=1"
            }
        },
        {
            "name": "lsan",
            "inherits": "test-base",
            "configurePreset": "lsan",
            "environment": {
                "LSAN_OPTIONS": "report_objects=1"
            }
        },
        {
            "name": "coverage",
            "inherits": "test-base",
            "configurePreset": "coverage"
        }
    ],
    "packagePresets": [
        {
            "name": "package-base",
            "hidden": true,
            "packageDirectory": "${sourceDir}/dist"
        },
        {
            "name": "package-linux-amd64-v1",
            "inherits": "package-base",
            "configurePreset": "linux-amd64-v1",
            "variables": {
                "CPACK_PACKAGE_FILE_NAME": "template-iso-c-$env{VERSION}-linux-amd64-v1"
            }
        },
        {
            "name": "package-linux-amd64-v2",
            "inherits": "package-base",
            "configurePreset": "linux-amd64-v2",
            "variables": {
                "CPACK_PACKAGE_FILE_NAME": "template-iso-c-$env{VERSION}-linux-amd64-v2"
            }
        },
        {
            "name": "package-linux-amd64-v3",
            "inherits": "package-base",
            "configurePreset": "linux-amd64-v3",
            "variables": {
                "CPACK_PACKAGE_FILE_NAME": "template-iso-c-$env{VERSION}-linux-amd64-v3"
            }
        },
        {
            "name": "package-linux-arm64-armv8-a",
            "inherits": "package-base",
            "configurePreset": "linux-arm64-armv8-a",
            "variables": {
                "CPACK_PACKAGE_FILE_NAME": "template-iso-c-$env{VERSION}-linux-arm64-armv8-a"
            }
        },
        {
            "name": "package-linux-arm64-armv9-a",
            "inherits": "package-base",
            "configurePreset": "linux-arm64-armv9-a",
            "variables": {
                "CPACK_PACKAGE_FILE_NAME": "template-iso-c-$env{VERSION}-linux-arm64-armv9-a"
            }
        },
        {
            "name": "package-native",
            "inherits": "package-base",
            "configurePreset": "native",
            "variables": {
                "CPACK_PACKAGE_FILE_NAME": "template-iso-c-$env{VERSION}-native"
            }
        },
        {
            "name": "package-debug",
            "inherits": "package-base",
            "configurePreset": "debug",
            "variables": {
                "CPACK_PACKAGE_FILE_NAME": "template-iso-c-$env{VERSION}-debug"
            }
        },
        {
            "name": "package-release",
            "inherits": "package-base",
            "configurePreset": "release",
            "variables": {
                "CPACK_PACKAGE_FILE_NAME": "template-iso-c-$env{VERSION}-release"
            }
        }
    ],
