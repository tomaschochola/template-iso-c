{
    "$schema": "https://gitlab.kitware.com/cmake/cmake/-/raw/v4.4.4/Help/manual/presets/schema.json",
    "version": 12,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 4,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_C_FLAGS": "",
                "CMAKE_COMPILE_WARNING_AS_ERROR": true,
                "CMAKE_LINK_WARNING_AS_ERROR": true,
                "CMAKE_EXE_LINKER_FLAGS": "",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "X_CPACK_PACKAGE_VARIANT": "${presetName}"
            },
            "warnings": {
                "author": true,
                "deprecated": true,
                "experimental": true,
                "installAbsoluteDestination": true,
                "policy": true,
                "uninitialized": true,
                "unusedCli": true
            },
            "errors": {
                "author": true,
                "deprecated": true,
                "experimental": true,
                "installAbsoluteDestination": true,
                "policy": true,
                "uninitialized": true,
                "unusedCli": true
            }
        },
        {
            "name": "debug-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "BUILD_TESTING": true,
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS_DEBUG": "-Og -g3 -fno-omit-frame-pointer"
            }
        },
        {
            "name": "release-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "BUILD_TESTING": false,
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG"
            }
        },
        {
            "name": "debug",
            "inherits": "debug-base"
        },
        {
            "name": "release",
            "inherits": "release-base"
        },
        {
            "name": "fanalyzer",
            "inherits": "debug-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS_DEBUG": "-O0 -g -fanalyzer"
            }
        },
        {
            "name": "asan",
            "inherits": "debug-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS_DEBUG": "-Og -g -fno-omit-frame-pointer -fsanitize=address"
            }
        },
        {
            "name": "ubsan",
            "inherits": "debug-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS_DEBUG": "-Og -g -fno-omit-frame-pointer -fsanitize=undefined -fno-sanitize-recover=undefined"
            }
        },
        {
            "name": "tsan",
            "inherits": "debug-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS_DEBUG": "-Og -g -fno-omit-frame-pointer -fsanitize=thread"
            }
        },
        {
            "name": "lsan",
            "inherits": "debug-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS_DEBUG": "-Og -g -fno-omit-frame-pointer -fsanitize=leak"
            }
        },
        {
            "name": "valgrind",
            "inherits": "debug-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS_DEBUG": "-O0 -g"
            }
        },
        {
            "name": "coverage",
            "inherits": "debug-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS_DEBUG": "-O0 -g --coverage -fcondition-coverage -fpath-coverage -fprofile-abs-path"
            }
        },
        {
            "name": "linux-amd64-v1",
            "inherits": "release-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=x86-64"
            }
        },
        {
            "name": "linux-amd64-v2",
            "inherits": "release-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=x86-64-v2"
            }
        },
        {
            "name": "linux-amd64-v3",
            "inherits": "release-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=x86-64-v3"
            }
        },
        {
            "name": "native",
            "inherits": "release-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=native -mtune=native"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "headers",
            "configurePreset": "debug",
            "targets": ["all_verify_header_sets"]
        },
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "fanalyzer",
            "configurePreset": "fanalyzer"
        },
        {
            "name": "asan",
            "configurePreset": "asan"
        },
        {
            "name": "ubsan",
            "configurePreset": "ubsan"
        },
        {
            "name": "tsan",
            "configurePreset": "tsan"
        },
        {
            "name": "lsan",
            "configurePreset": "lsan"
        },
        {
            "name": "valgrind",
            "configurePreset": "valgrind"
        },
        {
            "name": "coverage",
            "configurePreset": "coverage",
            "cleanFirst": true
        },
        {
            "name": "linux-amd64-v1",
            "configurePreset": "linux-amd64-v1"
        },
        {
            "name": "linux-amd64-v2",
            "configurePreset": "linux-amd64-v2"
        },
        {
            "name": "linux-amd64-v3",
            "configurePreset": "linux-amd64-v3"
        },
        {
            "name": "native",
            "configurePreset": "native"
        }
    ],
    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        },
        {
            "name": "debug",
            "inherits": "test-base",
            "configurePreset": "debug"
        },
        {
            "name": "fanalyzer",
            "inherits": "test-base",
            "configurePreset": "fanalyzer"
        },
        {
            "name": "asan",
            "inherits": "test-base",
            "configurePreset": "asan"
        },
        {
            "name": "ubsan",
            "inherits": "test-base",
            "configurePreset": "ubsan"
        },
        {
            "name": "tsan",
            "inherits": "test-base",
            "configurePreset": "tsan"
        },
        {
            "name": "lsan",
            "inherits": "test-base",
            "configurePreset": "lsan"
        },
        {
            "name": "coverage",
            "inherits": "test-base",
            "configurePreset": "coverage"
        }
    ],
    "packagePresets": [
        {
            "name": "package-base",
            "hidden": true,
            "packageDirectory": "${sourceDir}/dist"
        },
        {
            "name": "package-linux-amd64-v1",
            "inherits": "package-base",
            "configurePreset": "linux-amd64-v1"
        },
        {
            "name": "package-linux-amd64-v2",
            "inherits": "package-base",
            "configurePreset": "linux-amd64-v2"
        },
        {
            "name": "package-linux-amd64-v3",
            "inherits": "package-base",
            "configurePreset": "linux-amd64-v3"
        },
        {
            "name": "package-native",
            "inherits": "package-base",
            "configurePreset": "native"
        },
        {
            "name": "package-debug",
            "inherits": "package-base",
            "configurePreset": "debug"
        },
        {
            "name": "package-release",
            "inherits": "package-base",
            "configurePreset": "release"
        }
    ],
    "workflowPresets": [
        {
            "name": "headers",
            "steps": [
                {
                    "type": "configure",
                    "name": "debug"
                },
                {
                    "type": "build",
